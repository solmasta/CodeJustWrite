{
  "name": "codejustwrite",
  "version": "0.1.0",
  "description": "Terminal-based, AI-assisted coding agent with DeepInfra/OpenAI backends, git+PR automation, and a sandbox (isolated test runs, constrained shell exec, Playwright browser checks).",
  "type": "module",
  "bin": {
    "cjw": "dist/index.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "diff": "^5.2.0",
    "dotenv": "^16.4.5",
    "openai": "^4.67.3",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/node": "^20.16.11",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^8.57.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
