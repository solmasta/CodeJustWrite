{
  "name": "@codejustwrite/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "CodeJustWrite desktop app — a native window around the local backend and chat UI, no terminal required.",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "package": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "build": {
    "appId": "com.codejustwrite.desktop",
    "productName": "CodeJustWrite",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      { "from": "../server/dist", "to": "server" },
      { "from": "../server/node_modules", "to": "server/node_modules" },
      { "from": "../server/package.json", "to": "server/package.json" },
      { "from": "../../packages/core/dist", "to": "core" },
      { "from": "../../packages/core/package.json", "to": "core/package.json" },
      { "from": "../web/dist", "to": "web" }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": "dmg"
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": "AppImage",
      "category": "Development"
    }
  }
}
