# Copy to apps/cli/.env (or run `cjw` from a directory containing a .env
# with these vars). CodeJustWrite never commits or logs these values.

# --- LLM providers (at least one required) ---
DEEPINFRA_KEY=
OPENROUTER_KEY=

# Which provider/model to boot into. Overridable per-session with /provider and /model.
CJW_DEFAULT_PROVIDER=deepinfra
CJW_DEFAULT_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# --- GitHub (required for PR automation) ---
# Only needed as a fallback when the `gh` CLI isn't installed/authenticated.
GITHUB_TOKEN=

# --- Sandbox ---
# Max seconds a single sandboxed shell command may run before being killed.
CJW_SHELL_TIMEOUT_SEC=120

# --- MCP connectors (static API key/token, no OAuth) ---
# JSON array of servers to attach as extra tools. See README.md for the
# stdio/http shape and how apiKey is passed to each. Leave unset for none.
CJW_MCP_SERVERS=
