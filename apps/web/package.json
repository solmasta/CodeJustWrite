{
  "name": "@codejustwrite/web",
  "version": "1.0.0",
  "description": "CodeJustWrite PWA — mobile-installable chat UI for the agent.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
