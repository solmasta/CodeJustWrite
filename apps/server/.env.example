# Copy to apps/server/.env for local dev. In production (Render/Fly/Railway/
# Docker), set these as real environment variables/secrets instead of a file.

# --- Auth (set this for any deploy reachable from the internet) ---
# The PWA sends this back as `Authorization: Bearer <token>`. Without it,
# ANYONE who can reach this server can run shell commands and push code.
CJW_AUTH_TOKEN=

# --- LLM providers (at least one required) ---
DEEPINFRA_KEY=
OPENROUTER_KEY=
CJW_DEFAULT_PROVIDER=deepinfra
CJW_DEFAULT_MODEL=moonshotai/Kimi-K3

# --- GitHub (required for PR automation) ---
# Only needed as a fallback when the `gh` CLI isn't installed/authenticated
# on the server host.
GITHUB_TOKEN=

# --- Render (optional — lets the agent manage its own deployment) ---
# An account-scoped API key (Render dashboard → Account Settings → API Keys).
# Gives the agent tools to check service/deploy status, view logs, trigger a
# redeploy, and set env vars on the given service — full account access, so
# only set this if you want the agent able to do all of that.
RENDER_API_KEY=
CJW_RENDER_SERVICE_ID=

# --- Cloudflare (optional — DNS/cache tools for a domain) ---
# An API token (Cloudflare dashboard → Manage Account → API Tokens). Only
# the DNS/cache-purge endpoints in cloudflare.ts are ever called regardless
# of the token's own scope, but the credential is as sensitive as whatever
# permissions you gave it when creating it.
CLOUDFLARE_API_TOKEN=
CJW_CLOUDFLARE_ZONE_ID=

# --- MCP connectors (static API key/token, no OAuth) ---
# JSON array of servers to attach as extra tools, shared across all sessions.
# See README.md for the stdio/http shape and how apiKey is passed to each.
CJW_MCP_SERVERS=

# --- Server ---
PORT=8787
# Where per-session repo clones are checked out. Defaults to the OS temp dir.
CJW_WORKSPACES_DIR=
# Idle session lifetime before its clone is deleted.
CJW_SESSION_TTL_MIN=120
# Cap on concurrent sessions (repo clones) at once.
CJW_MAX_SESSIONS=20
# Max seconds a single sandboxed shell command may run before being killed.
CJW_SHELL_TIMEOUT_SEC=120
